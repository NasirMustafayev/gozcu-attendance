<UserControl x:Class="GozcuStandalone.App.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,30,34,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Reports" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Label}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Report" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <ComboBox x:Name="KindBox" Width="230" Padding="10,8" SelectionChanged="Kind_Changed"/>
            </StackPanel>
            <StackPanel x:Name="MonthPanel" Margin="0,0,14,0">
                <TextBlock Text="Month" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <ComboBox x:Name="MonthBox" Width="130" Padding="10,8" SelectionChanged="Param_Changed"/>
            </StackPanel>
            <StackPanel x:Name="PersonPanel" Margin="0,0,14,0">
                <TextBlock Text="Person" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <ComboBox x:Name="PersonBox" Width="230" Padding="10,8" DisplayMemberPath="Display" SelectionChanged="Param_Changed"/>
            </StackPanel>
            <StackPanel x:Name="RangePanel" Orientation="Horizontal" Margin="0,0,0,0">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="From" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="FromBox" Width="140" SelectedDateChanged="Date_Changed"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="To" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="ToBox" Width="140" SelectedDateChanged="Date_Changed"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Filter" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="SearchBox" Width="190" TextChanged="Search_Changed"/>
            </StackPanel>
            <Button Content="Export CSV" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="Export_Click"/>
            <Button Content="Print / PDF" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="Print_Click"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="ReportGrid" Style="{StaticResource Grid}" IsReadOnly="True" AutoGenerateColumns="True"
                          AutoGeneratingColumn="ReportGrid_AutoGeneratingColumn"/>
                <TextBlock x:Name="EmptyText" Text="Nothing to report for these settings." Style="{StaticResource Label}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="FooterText" Style="{StaticResource Label}" FontSize="12" TextWrapping="Wrap" Margin="2,12,0,0"/>
    </Grid>
</UserControl>
