<Window x:Class="GozcuStandalone.App.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Devices" Width="640" Height="520" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Page}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Devices" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Every terminal this app syncs with. Scans from all of them land in the same database, tagged with which device they came from."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Add device" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="Add_Click"/>
            <Button Content="Edit" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Edit_Click"/>
            <Button Content="Delete" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Delete_Click"/>
            <Button Content="Close" Style="{StaticResource GhostButton}" IsCancel="True" Click="Close_Click"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="DeviceGrid" Style="{StaticResource Grid}" IsReadOnly="True" MouseDoubleClick="Edit_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" MinWidth="110"/>
                    <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="120"/>
                    <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="140"/>
                    <DataGridTextColumn Header="SERIAL" Binding="{Binding Serial}" Width="110"/>
                    <DataGridTextColumn Header="ENABLED" Binding="{Binding Enabled}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
