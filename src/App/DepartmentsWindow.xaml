<Window x:Class="GozcuStandalone.App.DepartmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Departments" Width="520" Height="520" MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Page}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Departments" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Use departments to look at one group of people at a time. Assign people to a department on the People page."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="New department" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="New_Click"/>
            <Button Content="Rename" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Rename_Click"/>
            <Button Content="Delete" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Delete_Click"/>
            <Button Content="Close" Style="{StaticResource GhostButton}" IsCancel="True" Click="Close_Click"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="DeptGrid" Style="{StaticResource Grid}" IsReadOnly="True" MouseDoubleClick="Rename_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="PEOPLE" Binding="{Binding People}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
