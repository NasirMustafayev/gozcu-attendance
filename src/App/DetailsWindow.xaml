<Window x:Class="GozcuStandalone.App.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Details" Width="860" Height="660" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Page}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Label}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Filter" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterBox" Width="220" TextChanged="Filter_Changed"/>
            </StackPanel>
            <Button Content="Export" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="Export_Click"/>
            <Button Content="Print / PDF" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="Print_Click"/>
            <Button Content="Close" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" IsCancel="True" Click="Close_Click"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="DetailsGrid" Style="{StaticResource Grid}" IsReadOnly="True" AutoGenerateColumns="True"
                          AutoGeneratingColumn="Grid_AutoGeneratingColumn" MouseDoubleClick="Grid_DoubleClick"/>
                <TextBlock x:Name="EmptyText" Text="Nobody to show." Style="{StaticResource Label}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="FooterText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,12,0,0"/>
    </Grid>
</Window>
