<UserControl x:Class="GozcuStandalone.App.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,30,34,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Schedule" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Label}" FontSize="13" Margin="0,4,0,0"
                       Text="Who works which shift on which day. Reports use this to decide what counts as late, overtime or absent."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="TabCalendar" Content="Calendar" Style="{StaticResource SubTab}" IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabShifts" Content="Shifts" Style="{StaticResource SubTab}" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabLeave" Content="Leave" Style="{StaticResource SubTab}" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabHolidays" Content="Holidays" Style="{StaticResource SubTab}" Checked="Tab_Checked"/>
        </StackPanel>

        <!-- Calendar -->
        <Grid x:Name="CalendarPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <WrapPanel Margin="0,0,0,12">
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Month" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MonthBox" Width="130" Padding="10,8" SelectionChanged="Month_Changed"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Find person" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <TextBox x:Name="CalSearch" Width="200" TextChanged="CalSearch_Changed"/>
                </StackPanel>
            </WrapPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Assign shifts" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                    <TextBlock Style="{StaticResource Label}" Margin="0,2,0,10"
                               Text="Select people in the table below (Ctrl or Shift to select several), pick a shift and the dates, then press Apply."/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Shift" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ShiftBox" Width="200" Padding="10,8" DisplayMemberPath="Label"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="From" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="ApplyFrom" Width="140"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="To" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="ApplyTo" Width="140"/>
                        </StackPanel>
                        <CheckBox x:Name="OnlyShiftDays" Content="Skip days the shift doesn't run" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,16,10"/>
                        <Button Content="Apply" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="Apply_Click"/>
                        <Button Content="Remove shifts" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="RemoveShifts_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="CalGrid" Style="{StaticResource Grid}" IsReadOnly="True" AutoGenerateColumns="True"
                          SelectionMode="Extended" SelectionUnit="FullRow" FrozenColumnCount="1" RowHeight="34"
                          AutoGeneratingColumn="CalGrid_AutoGeneratingColumn"/>
            </Border>

            <TextBlock Grid.Row="3" x:Name="LegendText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="2,10,0,0"/>
        </Grid>

        <!-- Shifts -->
        <Grid x:Name="ShiftsPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="New shift" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="NewShift_Click"/>
                <Button Content="Edit" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="EditShift_Click"/>
                <Button Content="Delete" Style="{StaticResource GhostButton}" Click="DeleteShift_Click"/>
            </WrapPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="ShiftsGrid" Style="{StaticResource Grid}" IsReadOnly="True" MouseDoubleClick="EditShift_Click">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="HOURS" Binding="{Binding Hours}" Width="130"/>
                        <DataGridTextColumn Header="DAYS" Binding="{Binding Days}" Width="200"/>
                        <DataGridTextColumn Header="LATE ARRIVAL GRACE" Binding="{Binding LateGrace}" Width="150"/>
                        <DataGridTextColumn Header="EARLY LEAVE GRACE" Binding="{Binding EarlyLeave}" Width="150"/>
                        <DataGridTextColumn Header="OVERTIME AFTER" Binding="{Binding LateLeave}" Width="130"/>
                        <DataGridTextColumn Header="UNPAID BREAK" Binding="{Binding Break}" Width="120"/>
                        <DataGridTextColumn Header="DAYS ASSIGNED" Binding="{Binding Assigned}" Width="120"/>
                        <DataGridTextColumn Header="ORIGIN" Binding="{Binding Origin}" Width="170"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Leave -->
        <Grid x:Name="LeavePanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Record annual leave, sick days and business trips. People on leave are not reported absent, and the calendar marks those days with L."/>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Person" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LeavePerson" Width="230" Padding="10,8" DisplayMemberPath="Display"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Type" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LeaveType" Width="150" Padding="10,8" DisplayMemberPath="Label"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="From" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="LeaveFrom" Width="140"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="To (inclusive)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="LeaveTo" Width="140"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Note (optional)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <TextBox x:Name="LeaveNote" Width="170"/>
                </StackPanel>
                <Button Content="Add leave" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="AddLeave_Click"/>
                <Button Content="Delete selected" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="DeleteLeave_Click"/>
            </WrapPanel>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="LeaveGrid" Style="{StaticResource Grid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PERSON" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="FROM" Binding="{Binding From}" Width="110"/>
                            <DataGridTextColumn Header="TO" Binding="{Binding To}" Width="110"/>
                            <DataGridTextColumn Header="DAYS" Binding="{Binding Days}" Width="70"/>
                            <DataGridTextColumn Header="TYPE / NOTE" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="ORIGIN" Binding="{Binding Origin}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="LeaveEmpty" Text="No leave recorded for this period." Style="{StaticResource Label}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Holidays -->
        <Grid x:Name="HolidaysPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Holidays apply to everyone: nobody is reported absent on these days. Personal leave copied from the original software is applied automatically."/>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Date" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="HolidayDate" Width="150"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <TextBox x:Name="HolidayName" Width="240"/>
                </StackPanel>
                <Button Content="Add holiday" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,10,0" Click="AddHoliday_Click"/>
                <Button Content="Remove selected" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="RemoveHoliday_Click"/>
            </WrapPanel>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="HolidayGrid" Style="{StaticResource Grid}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding DateText}" Width="140"/>
                            <DataGridTextColumn Header="DAY" Binding="{Binding Day}" Width="90"/>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="HolidayEmpty" Text="No holidays added yet." Style="{StaticResource Label}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
