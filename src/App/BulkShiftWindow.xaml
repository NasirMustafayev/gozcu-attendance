<Window x:Class="GozcuStandalone.App.BulkShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply shift" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" ShowInTaskbar="False">
    <StackPanel Margin="28,26,28,24">
        <TextBlock x:Name="HeadText" Text="Apply shift" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="IntroText" Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,18"/>

        <TextBlock Text="Shift" Style="{StaticResource Label}" Margin="0,0,0,4"/>
        <ComboBox x:Name="ShiftBox" Padding="10,8" FontSize="14"/>
        <CheckBox x:Name="ClearBox" Content="Remove shift instead (clear the schedule for this range)" Margin="0,10,0,0" Checked="ClearBox_Changed" Unchecked="ClearBox_Changed"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="From" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <DatePicker x:Name="FromBox" Padding="6,6"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="To" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <DatePicker x:Name="ToBox" Padding="6,6"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="OnlyShiftDaysBox" Content="Only on days the shift runs" IsChecked="True" Margin="0,12,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="Apply" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
