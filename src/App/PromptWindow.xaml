<Window x:Class="GozcuStandalone.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attendance" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" ShowInTaskbar="False">
    <StackPanel Margin="28,26,28,24">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Detail" Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,14"/>
        <TextBox x:Name="Input"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
