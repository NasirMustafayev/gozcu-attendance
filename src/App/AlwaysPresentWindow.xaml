<Window x:Class="GozcuStandalone.App.AlwaysPresentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Always present" Width="620" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Page}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Always present" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Turn this on for someone who should always show as present on the dashboard, with no real scan needed (for example someone who never badges in). First in / Last out are shown for them every day on days they have no real scan, in HH:mm. They are also left out of absence, late and early-leave reports."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Close" Style="{StaticResource GhostButton}" IsCancel="True" Click="Close_Click"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="Grid" Style="{StaticResource Grid}" CellEditEnding="Grid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Enroll}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" MinWidth="140" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                    <DataGridTextColumn Header="FIRST IN" Binding="{Binding FirstIn}" Width="90"/>
                    <DataGridTextColumn Header="LAST OUT" Binding="{Binding LastOut}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
