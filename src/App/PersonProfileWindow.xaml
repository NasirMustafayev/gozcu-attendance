<Window x:Class="GozcuStandalone.App.PersonProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Page}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <StackPanel Margin="28,26,28,24">
        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <TextBlock x:Name="NameText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Label}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="40,0,0,0" VerticalAlignment="Top">
                <ComboBox x:Name="MonthBox" Width="150" Padding="10,8" SelectionChanged="Month_Changed"/>
            </StackPanel>
        </StackPanel>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition Height="12"/><RowDefinition/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="ABSENT" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AbsentValue" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Bad}" Margin="0,6,0,0"/>
                    <TextBlock Text="day(s) this month" Style="{StaticResource Label}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="PRESENT" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PresentValue" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,6,0,0"/>
                    <TextBlock Text="day(s) with a scan" Style="{StaticResource Label}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="WORKED" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WorkedValue" Text="—" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,6,0,0"/>
                    <TextBlock Text="this month" Style="{StaticResource Label}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="LATE" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LateValue" Text="0" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Warn}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="LateHint" Text="time(s)" Style="{StaticResource Label}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="LEFT EARLY" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EarlyValue" Text="0" FontSize="26" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,0"/>
                    <TextBlock x:Name="EarlyHint" Text="time(s)" Style="{StaticResource Label}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="OVERTIME" Style="{StaticResource Label}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="OvertimeValue" Text="—" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,6,0,0"/>
                    <TextBlock Text="this month" Style="{StaticResource Label}"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Full timesheet" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Timesheet_Click"/>
            <Button Content="Close" Style="{StaticResource PrimaryButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
