<Window x:Class="GozcuStandalone.App.DeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" ShowInTaskbar="False">
    <StackPanel Margin="28,26,28,24">
        <TextBlock x:Name="HeadText" Text="Add device" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,18"
                   Text="A face or fingerprint terminal on your local network."/>

        <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox"/>

        <TextBlock Text="Location (optional)" Style="{StaticResource Label}" Margin="0,14,0,4"/>
        <TextBox x:Name="LocationBox"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="IP address" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="IpBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Port" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="PortBox"/>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="EnabledBox" Content="Enabled (included in sync)" IsChecked="True" Margin="0,14,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="TestButton" Content="Test connection" Style="{StaticResource GhostButton}" Click="Test_Click"/>
            <TextBlock x:Name="TestResult" Style="{StaticResource Label}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
