<Window x:Class="GozcuStandalone.App.ManualEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add manual entry" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" ShowInTaskbar="False">
    <StackPanel Margin="28,26,28,24">
        <TextBlock x:Name="HeadText" Text="Add manual entry" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="IntroText" Style="{StaticResource Label}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,18"
                   Text="Use this when a scan is missing, for example the device was offline or someone forgot to scan. Fill in the log in time, the log off time, or both. Entries are marked as manual in every report and kept in the audit list."/>

        <TextBlock Text="Person" Style="{StaticResource Label}" Margin="0,0,0,4"/>
        <ComboBox x:Name="PersonBox" IsEditable="True" Padding="10,8" FontSize="14"
                  DisplayMemberPath="Display" TextSearch.TextPath="Display" IsTextSearchEnabled="True"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="100"/><ColumnDefinition x:Name="OutGap" Width="14"/><ColumnDefinition x:Name="OutCol" Width="100"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Date" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <DatePicker x:Name="DateBox" Padding="6,6"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="TimeLabel" Text="Log in (HH:mm)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="TimeBox"/>
            </StackPanel>
            <StackPanel x:Name="OutPanel" Grid.Column="4">
                <TextBlock Text="Log off (HH:mm)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="OutBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Reason" Style="{StaticResource Label}" Margin="0,14,0,4"/>
        <TextBox x:Name="NoteBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="Add entry" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
